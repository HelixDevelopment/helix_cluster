# root-level built cmd binaries (from `go build ./cmd/...` in repo root)
# (anchored with leading slash so they never match cmd/* source dirs)
/helix-*
/helixd
/htmux
/hxc-registry
/helix_infra

# docs_chain engine runtime (§11.4.106) — state + staging sidecars are generated
.docs_chain/state.json
*.docs_chain.tmp
qa-results/docs_chain/

# stale root-level test binaries (§11.4.30)
/e2e.test
/jwt.test

# built engine binaries (docs_chain etc.)
/bin/

# runtime test evidence (§7.1 capture); closure evidence is referenced in HXC item_history
qa-results/

# CycloneDX SBOM build derivatives (CONST-053) — regenerate via `make sbom` (HXC-1635)
sbom/*.cdx.json
