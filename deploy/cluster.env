# =============================================================================
# Helix Cluster OS — single source of truth for deployment topology.
# =============================================================================
# NOTHING in the deploy scripts or compose files is hardcoded: every IP, port,
# host and key is derived from this file (or auto-detected at runtime). This is
# the config-driven deployment contract for D14 (persistent worker membership).
#
# Usage:
#   - docker/podman compose reads it via `--env-file deploy/cluster.env` so the
#     ${VAR} substitutions in deploy/compose/helix_infra.yml resolve.
#   - deploy/deploy-workers.sh and dist/agent-launch.sh `source` it to derive
#     etcd endpoints, the node inventory, and per-node parameters.
#
# Override any value from the environment before invoking the scripts, e.g.:
#   HELIX_HOST_IP=10.0.0.5 ./deploy/deploy-workers.sh
# An unset HELIX_HOST_IP is auto-detected (ipconfig getifaddr / ip route) by the
# scripts — do NOT pin it to a literal address here.
# =============================================================================

# -----------------------------------------------------------------------------
# Control host (where the podman/docker infra stack runs: etcd, helixd, ...).
# -----------------------------------------------------------------------------
# HELIX_HOST_IP is the address remote workers must use to reach the control
# host. Leave it EMPTY here so it is auto-detected at deploy time. Compose uses
# it for the etcd advertised client URLs so remote clients are told a reachable
# address (NOT the in-network container name etcd-N).
HELIX_HOST_IP=

# LAN interface hints for auto-detection (first match wins). macOS: en0/en1;
# Linux: typically the global-scope 192.168.x address.
HELIX_HOST_IFACE_DARWIN=en0
HELIX_LAN_PREFIX=192.168.

# -----------------------------------------------------------------------------
# etcd cluster — published host ports (host-side). Container client port is
# always 2379; these are the host ports we publish so workers can reach EACH
# member directly (removes the single-published-member trap).
# -----------------------------------------------------------------------------
ETCD_1_CLIENT_PORT=2379
ETCD_2_CLIENT_PORT=2479
ETCD_3_CLIENT_PORT=2579
ETCD_1_PEER_PORT=2380
ETCD_2_PEER_PORT=2381
ETCD_3_PEER_PORT=2382

# Comma-separated etcd client endpoints as seen FROM a remote worker. Derived
# from HELIX_HOST_IP + the published ports above. Scripts recompute this after
# auto-detecting HELIX_HOST_IP, so the literal here is only a documented shape.
# (Recomputed in deploy-workers.sh — do not rely on this literal value.)
HELIX_ETCD_ENDPOINTS=

# etcd endpoints for IN-CLUSTER containers (helixd et al. on the helix bridge).
# These use container-network names, not the host IP. Override only for unusual
# topologies; the compose default is etcd-1:2379,etcd-2:2379,etcd-3:2379.
HELIX_ETCD_ENDPOINTS_INCLUSTER=

# -----------------------------------------------------------------------------
# Worker node inventory.
# Format per entry:  id|host|region|wg-port
# Add a node here and re-run deploy/deploy-workers.sh — no script edits needed.
# -----------------------------------------------------------------------------
HELIX_NODE_thinker="thinker|thinker.local|lan|51820"
HELIX_NODE_nezha="nezha|nezha.local|lan|51820"

# Space-separated list of the inventory keys above to deploy. Add new node ids
# here to include them in a deploy run.
HELIX_NODES="thinker nezha amber"

# -----------------------------------------------------------------------------
# Worker runtime defaults (per-node SWIM bind / WireGuard). bind-addr is
# auto-detected ON EACH WORKER (its own LAN IP) — never hardcoded.
# -----------------------------------------------------------------------------
HELIX_AGENT_SWIM_PORT=7946
HELIX_AGENT_BINARY=helix-agent
HELIX_AGENT_REMOTE_HOME=/home/milosvasic
HELIX_SSH_USER=milosvasic
HELIX_NODE_amber="amber|amber.local|lan|51820"
